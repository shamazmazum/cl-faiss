(in-package :cl-faiss/tests)

(def-suite fp-index :description "FP indinces")

(defun run-tests ()
  (every #'identity
         (mapcar (lambda (suite)
                   (let ((status (run suite)))
                     (explain! status)
                     (results-status status)))
                 '(fp-index))))

(in-suite fp-index)

(serapeum:-> l2-metric ((simple-array single-float (*))
                        (simple-array single-float (*)))
             (values single-float &optional))
(defun l2-metric (v1 v2)
  (declare (optimize (speed 3)))
  (assert (= (length v1)
             (length v2)))
  (loop for x across v1
        for y across v2
        sum (expt (- x y) 2) single-float))

(serapeum:-> l1-metric ((simple-array single-float (*))
                        (simple-array single-float (*)))
             (values single-float &optional))
(defun l1-metric (v1 v2)
  (declare (optimize (speed 3)))
  (assert (= (length v1)
             (length v2)))
  (loop for x across v1
        for y across v2
        sum (abs (- x y)) single-float))

(serapeum:-> linf-metric ((simple-array single-float (*))
                          (simple-array single-float (*)))
             (values single-float &optional))
(defun linf-metric (v1 v2)
  (declare (optimize (speed 3)))
  (assert (= (length v1)
             (length v2)))
  (loop for x across v1
        for y across v2
        maximize (abs (- x y)) single-float))

(serapeum:-> row ((simple-array * (* *)) (unsigned-byte 32))
             (values (simple-array * (*)) &optional))
(declaim (inline row))
(defun row (vs k)
  (let ((row (make-array (array-dimension vs 1)
                         :element-type (array-element-type vs)))
        (idx (array-row-major-index vs k 0)))
    (loop for i below (length row) do
      (setf (aref row i)
            (row-major-aref vs (+ idx i))))
    row))

(serapeum:-> vector-to-query ((simple-array * (*)))
             (values (simple-array * (1 *)) &optional))
(declaim (inline vector-to-query))
(defun vector-to-query (v)
  (let ((array (make-array (list 1 (length v))
                           :element-type (array-element-type v))))
    (loop for i below (length v) do
      (setf (aref array 0 i)
            (aref v i)))
    array))

(serapeum:-> vector2-to-query ((simple-array * (*))
                               (simple-array * (*)))
             (values (simple-array * (2 *)) &optional))
(declaim (inline vector2-to-query))
(defun vector2-to-query (v1 v2)
  (assert (= (length v1)
             (length v2)))
  (assert (equalp (array-element-type v1)
                  (array-element-type v2)))
  (let ((array (make-array (list 2 (length v1))
                           :element-type (array-element-type v1))))
    (loop for i below (length v1) do
      (setf (aref array 0 i)
            (aref v1 i)))
    (loop for i below (length v2) do
      (setf (aref array 1 i)
            (aref v2 i)))
    array))

(serapeum:-> find-k-closest ((simple-array single-float (*))
                             (simple-array single-float (* *))
                             (function ((simple-array single-float (*))
                                        (simple-array single-float (*)))
                                       (values single-float &optional))
                             (integer 1))
             (values (simple-array (unsigned-byte 64) (*))
                     (simple-array single-float       (*))
                     &optional))
(defun find-k-closest (v vs f k)
  (declare (optimize (speed 3)))
  (assert (= (array-dimension vs 1)
             (length v)))
  (let ((queue (make-queue (1+ k))))
    (loop for i below (array-dimension vs 0)
          for d = (funcall f (row vs i) v)
          do (enqueue-limited! queue i (- d) k))
    (let ((indices (map '(vector (unsigned-byte 64))
                        #'identity
                        (to-sorted-list! queue))))
      (values indices
              (map '(vector single-float)
                   (lambda (i)
                     (funcall f (row vs i) v))
                   indices)))))

(serapeum:-> find-k-closest-faiss ((simple-array single-float (* *))
                                   (simple-array single-float (* *))
                                   faiss:metric (integer 1))
             (values (simple-array (unsigned-byte 64) (* *))
                     (simple-array single-float       (* *))
                     &optional))
(defun find-k-closest-faiss (q vs metric k)
  (declare (optimize (speed 3)))
  (multiple-value-bind (dists labels)
      (faiss:with-index (index (array-dimension vs 1) "Flat" metric)
        (faiss:index-add index vs)
        (faiss:index-search index q k))
    (values labels dists)))

(defun gen-vector (&key dim)
  (gen-buffer :length        (gen-integer :min dim :max dim)
              :element-type 'single-float
              :elements      (gen-float :bound 1.0)))

(defun gen-vectors (&key n dim)
  (lambda ()
    (let ((array (make-array (list n dim) :element-type 'single-float)))
      (loop for i below (array-total-size array) do
        (setf (row-major-aref array i)
              (- (random 2.0) 1.0)))
      array)))

(test flat-index
  (for-all* ((dim (gen-integer :min   3 :max   200))
             (ndb (gen-integer :min 300 :max 30000))
             (k   (gen-integer :min   1 :max    10))
             (vs  (gen-vectors :dim dim :n ndb))
             (v   (gen-vector  :dim dim)))
    (loop for metric-t in '(:l1 :l2 :linf)
          for metric-f in `(,#'l1-metric ,#'l2-metric ,#'linf-metric) do
            (serapeum:mvlet ((ind1 dist1 (find-k-closest-faiss (vector-to-query v)
                                                               vs metric-t k))
                             (ind2 dist2 (find-k-closest v vs metric-f k)))
              (is-true (every #'approx:approxp (row dist1 0) dist2))
              (is-true (every #'= (row ind1 0) ind2))))))

(test multiple-queries
  (for-all* ((dim (gen-integer :min   3 :max   200))
             (ndb (gen-integer :min 300 :max 30000))
             (k   (gen-integer :min   1 :max    10))
             (vs  (gen-vectors :dim dim :n ndb))
             (v1  (gen-vector  :dim dim))
             (v2  (gen-vector  :dim dim)))
    (serapeum:mvlet ((ind1 dist1 (find-k-closest-faiss (vector-to-query  v1) vs :l2 k))
                     (ind2 dist2 (find-k-closest-faiss (vector-to-query  v2) vs :l2 k))
                     (ind  dist  (find-k-closest-faiss (vector2-to-query v1 v2) vs :l2 k)))
      (is-true (every #'approx:approxp (row dist1 0) (row dist 0)))
      (is-true (every #'= (row ind1 0) (row ind 0)))
      (is-true (every #'approx:approxp (row dist2 0) (row dist 1)))
      (is-true (every #'= (row ind2 0) (row ind 1))))))
